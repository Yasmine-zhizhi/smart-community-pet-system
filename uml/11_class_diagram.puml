@startuml
' ============================================================
' 图11 智慧社区宠物管理系统 分析类图
' 优化点：提高分辨率、放大字号、按 MVC 分层分组、补全 7 个边界类
' ============================================================
skinparam dpi 300
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 45

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #475569
  BorderThickness 1.4
  FontSize 13
  FontColor #0F172A
  AttributeFontSize 12
}

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  BorderThickness 1.6
  FontSize 15
  FontStyle bold
  FontColor #334155
}

skinparam arrow {
  Color #64748B
  Thickness 1.3
  FontSize 12
  FontColor #475569
}

package "实体类 Entity" #FFF7ED {

  class Owner {
    +phone : String
    +password : String
    +name : String
    +create()
  }

  abstract class Pet {
    +name : String
    +vaccineExpiry : Date
  }

  class Dog {
    +breed : String
    +size : Enum{SMALL, LARGE}
    +registrationProof : byte[]
  }

  class Cat {
    +photo : byte[]
  }

  class PetApplication {
    +appId : String
    +type : Enum{DOG, CAT, RENEW}
    +status : Enum{PENDING, APPROVED, SUPPLEMENT, REJECTED}
    +submit()
  }

  class PetCertificate {
    +certId : String
    +validity : Date
    +status : Enum{VALID, EXPIRED, FROZEN}
  }

  class Reservation {
    +reserveId : String
    +date : Date
    +timeSlot : Time
    +zone : Enum{SMALL_DOG, LARGE_DOG}
    +status : Enum{CONFIRMED, CANCELLED, COMPLETED}
  }

  class WaitlistEntry {
    +position : int
    +notify()
  }

  class ViolationRecord {
    +violationId : String
    +date : Date
    +type : String
    +confirm()
  }

  class SystemParameter {
    +key : String
    +value : String
  }
}

package "控制类 Control" #EFF6FF {

  class OwnerManager {
    +register()
    +login()
  }

  class PetManager {
    +submitRegistration()
    +reviewApplication()
    +queryPet()
  }

  class ReserveManager {
    +reserve()
    +cancel()
    +waitlist()
  }

  class SystemManager {
    +recordViolation()
    +manageCertificate()
    +setParameter()
  }
}

package "边界类 Boundary" #F0FDF4 {

  class LoginUI {
    +inputPhone()
    +inputCode()
  }

  class DogRegisterUI {
    +fillForm()
    +uploadMaterial()
  }

  class CatRegisterUI {
    +fillForm()
    +uploadPhoto()
  }

  class ReviewUI {
    +listApplication()
    +decide()
  }

  class PetProfileUI {
    +showProfile()
    +showCertificate()
  }

  class ReserveUI {
    +selectSlot()
    +submit()
  }

  class SettingUI {
    +editParameter()
  }
}

package "外部系统类" #FEF2F2 {

  class MessagePlatform {
    +sendMessage()
  }
}

' ---------- 实体类之间的关系 ----------
Owner "1" -- "*" Pet : 拥有
Pet <|-- Dog
Pet <|-- Cat
Pet "1" -- "*" PetApplication : 提交
PetApplication "1" -- "0..1" PetCertificate : 生成
Pet "1" -- "*" Reservation : 预约
Reservation "1" -- "0..1" WaitlistEntry : 候补
Pet "1" -- "*" ViolationRecord : 违规

' ---------- 边界类 → 控制类 ----------
LoginUI ..> OwnerManager
DogRegisterUI ..> PetManager
CatRegisterUI ..> PetManager
ReviewUI ..> PetManager
PetProfileUI ..> PetManager
ReserveUI ..> ReserveManager
SettingUI ..> SystemManager

' ---------- 控制类 → 实体类 ----------
OwnerManager ..> Owner
PetManager ..> Pet
ReserveManager ..> Reservation
SystemManager ..> ViolationRecord
SystemManager ..> SystemParameter

' ---------- 外部系统 ----------
SystemManager ..> MessagePlatform : 调用
MessagePlatform ..> Owner : 推送通知

@enduml
