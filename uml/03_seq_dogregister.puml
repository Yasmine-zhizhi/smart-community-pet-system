@startuml
skinparam backgroundColor white
skinparam shadowing false

actor "业主" as Owner
participant "DogRegisterUI" as UI
participant "PetManager" as Ctrl
participant "PetLib" as Lib

Owner -> UI : 填写犬类信息\n上传登记证明+疫苗材料
UI -> Ctrl : submitDogRegistration(info, materials)
activate Ctrl
Ctrl -> Ctrl : 校验材料完整性 <<include>>
Ctrl -> Lib : createApplication(DOG, info, materials)
activate Lib
Lib --> Ctrl : 返回申请编号 + "待审核"状态
deactivate Lib
Ctrl --> UI : 提交成功 + 申请编号
deactivate Ctrl
UI --> Owner : 显示提交成功\n提示"等待物业审核"
@enduml